MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: BabkaDialog4
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0421\u0442\u043E\u0439, \u043A\u0430\u0440\u0433\u0430 \u0441\u0442\u0430\u0440\u0430\u044F!\n\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u044B \u043E\u0442\u0432\u0435\u0442\u044B"
    textEn: 'Wait, you old crow!

      We need answers'
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: ...
    textEn: ...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043C\u0435\u0441\u0442\u043E?\n\u0418 \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C?"
    textEn: 'What is this place?

      And where did you come from anyway?'
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u041E\u0442\u0432\u0435\u0442\u044B \u0435\u0439 \u043F\u043E\u0434\u0430\u0432\u0430\u0439...\n\u0420\u0430\u043D\u044C\u0448\u0435 \u0436\u0435 \u043B\u044E\u0434\u0438 \u0431\u0435\u0437 \u043E\u0442\u0432\u0435\u0442\u043E\u0432 \u0436\u0438\u043B\u0438 - \u0438 \u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0443 \u0441\u0430\u0436\u0430\u043B\u0438"
    textEn: 'Give her answers...

      Before, people lived without answers - and nothing happened, they planted potatoes'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041D\u0435 \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0430."
    textEn: Don't dodge the question.
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0413\u0434\u0435 \u043C\u044B?"
    textEn: Where are we?
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0412 \u043C\u0435\u0441\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C\u2026\n\u0438 \u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u0435\u0442\u044C \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0430 \u043C\u043E\u043B\u0447\u0430\u0442\u044C."
    textEn: "In a place that should not have existed\u2026\nand about whose existence the Net warned to stay silent."
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u042F \u0422\u0410\u041A \u0418 \u0413\u041E\u0412\u041E\u0420\u0418\u041B\u0410!"
    textEn: I TOLD YOU SO!
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u042F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 - \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F!\n\u041C\u044B \u0432\u0438\u0434\u0438\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0443 \u044D\u0442\u043E\u0439 \u0448\u0442\u0443\u043A\u0438, \u0430 \u0432\u043D\u0443\u0442\u0440\u0438 \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0451!"
    textEn: "I said the internet isn't just technology! \nWe only see the tip of this thing, but there's something more inside!"
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041C\u043D\u0435 \u0443\u0436\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u044D\u0442\u043E\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
    textEn: I don't like this conversation anymore.
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0410 \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!"
    textEn: Well I like it!
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0422\u043E \u0435\u0441\u0442\u044C \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F...\n\u041D\u043E \u043D\u0430\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u043F\u0440\u0430\u0432\u0430!"
    textEn: 'I mean, I don''t really like it...

      It''s obvious I''m right!'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0410 \u043A\u0430\u043A \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C?"
    textEn: How did you get here?
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u041F\u043E\u043C\u0435\u0440\u043B\u0430, \u0434\u0443\u0440\u0430."
    textEn: I died, fool.
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442..."
    textEn: Someone set up me the internet...
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0410 \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A \u0428\u0410\u0420\u0410\u0425\u041D\u0423\u041B\u041E."
    textEn: And then BANG.
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0427\u0435\u0433\u043E \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u043E?!"
    textEn: What bang?!
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0414\u0430 \u043A\u0442\u043E \u0436 \u0435\u0433\u043E \u0437\u043D\u0430\u0435\u0442."
    textEn: Hell if anyone knows.
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u043E\u0443\u0442\u0435\u0440 \u043C\u0438\u0433\u0430\u043B, \u043F\u043E\u0442\u043E\u043C \u043A\u043E\u0442 \u043E\u0431\u043B\u0435\u0437, \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u043D\u044F \u0437\u0430\u0441\u043E\u0441a\u043B\u043E \u0441\u044E\u0434\u0430 \u043A \u0447\u0435\u0440\u0442\u043E\u0432\u043E\u0439 \u043C\u0430\u0442\u0435\u0440\u0438."
    textEn: First the router blinked, then the cat licked it, then I got sucked in by the damn motherboard.
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u042D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A... \n\u0431\u0440\u0435\u0434 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0435\u0433\u043E."
    textEn: 'That sounds like...

      the ravings of a madman.'
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0436 \u0440\u043E\u0432\u043D\u043E \u0442\u044B \u0441\u0442\u043E\u0438\u0448\u044C \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u043A\u043E\u0433\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0433\u043D\u0443\u043B\u0438 \u0434\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B."
    textEn: "You\u2019re standing far too straight for someone who was once beaten into shape."
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0412\u044B \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B\u0438?.."
    textEn: 'Did you hear

      that?..'
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0410,\u043F\u0440\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C. \u041C\u043D\u0435 \u043F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438, \u0437\u0430\u0431\u043E\u043B\u0442\u0430\u043B\u0430\u0441\u044C \u044F \u0441 \u0432\u0430\u043C\u0438."
    textEn: "Ah, it's woken up. I\u2019d better be moving on; I\u2019ve been talking too much with you all."
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0427\u0442\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C?"
    textEn: "What\u2019s woken up?"
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u041C\u0435\u0441\u0442\u043D\u044B\u0435. \u041D\u0435 \u043B\u044E\u0431\u044F\u0442, \u043A\u043E\u0433\u0434\u0430 \u0442\u0443\u0442 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0435 \u0448\u0430\u0441\u0442\u0430\u044E\u0442."
    textEn: "The locals. They don\u2019t like it when newcomers are pottering about here."
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0427\u0422\u041E \u0417\u041D\u0410\u0427\u0418\u0422 \"\u041C\u0415\u0421\u0422\u041D\u042B\u0415\"?!"
    textEn: WHAT DO YOU MEAN "LOCALS"?!
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043C\u0438 \u0443\u0432\u0438\u0434\u0438\u0442\u0435."
    textEn: You'll see for yourselves right now.
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0418 \u0434\u0430 - \u0435c\u043B\u0438 \u044D\u0442\u0430 \u043B\u043E\u0445\u043C\u0430\u0442\u0430\u044F \u0441\u0434\u043E\u0445\u043D\u0435\u0442, \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0439\u0441\u044F \u043E\u0441\u043E\u0431\u043E. \n\u041E\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043B\u043E\u0434\u044F\u0442\u0441\u044F."
    textEn: 'And yeah - if this hairy one croaks, don''t relax too much.

      They breed fast.'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0427\u0415\u0413\u041E?"
    textEn: WHAT?
  - speakerRu: 
    speakerEn: 
    textRu: "*\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\n\u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0442\u044C\u0441\u044F \u0432\n\u0432\u043E\u0437\u0434\u0443\u0445\u0435*"
    textEn: '*The Seer begins

      to dissolve into

      the air*'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0421\u0422\u041E\u0419\u0422\u0415."
    textEn: STOP.
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0427\u0435\u0433\u043E \u0435\u0449\u0451?"
    textEn: What else?
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041A\u0430\u043A \u043E\u0442\u0441\u044E\u0434\u0430 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F?"
    textEn: How do we get out of here?
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0425\u0435-\u0445\u0435..."
    textEn: Heh-heh...
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u0437\u043D\u0430\u043B\u0430 - \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u0443\u0436\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E."
    textEn: If I knew they wouldn't have me here.
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E."
    textEn: Nice.
  - speakerRu: 
    speakerEn: 
    textRu: "*\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E\n\u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044C...*"
    textEn: '*The Seer completely

      dissolved...*'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "...\u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B \u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0443\u043C\u043D\u0435\u0435."
    textEn: ...seems like she spoke in riddles on purpose to look smarter.
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041D\u0435\u0442."
    textEn: No.
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u044F."
    textEn: Seems like she's just old.
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u041B\u041A\u041C, \u0427\u0422\u041E\u0411\u042B \u0411\u042B\u0422\u042C \u0412\u0420\u0410\u0413\u041E\u0412"
    textEn: USE LMB TO ATTACK ENEMIES
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u041D\u0423 \u0418 \u041B\u0418\u041B\u0418\u0422 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u042E\u0422 \u0420\u0410\u0417\u041D\u042B\u0415 \u0422\u0418\u041F\u042B \u041E\u0420\u0423\u0416\u0418\u042F"
    textEn: INU AND LILIT USE DIFFERENT WEAPON TYPES
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u041D\u0423 \u041F\u041E\u0414\u0425\u041E\u0414\u0418\u0422 \u0414\u041B\u042F \u0411\u041B\u0418\u0416\u041D\u0418\u0425 \u0414\u0418\u0421\u0422\u0410\u041D\u0426\u0418\u0419, \u0410 \u041B\u0418\u041B\u0418\u0422 \u0414\u041B\u042F \u0414\u0410\u041B\u042C\u041D\u0418\u0425"
    textEn: INU IS FOR CLOSE RANGE, LILIT FOR LONG RANGE
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u041F\u041E\u041C\u0418\u041C\u041E \u041E\u0411\u042B\u0427\u041D\u041E\u0419 \u0410\u0422\u0410\u041A\u0418 \u0423 \u041D\u0418\u0425 \u0415\u0421\u0422\u042C \u041D\u0410\u0412\u042B\u041A\u0418"
    textEn: BESIDES BASIC ATTACK THEY HAVE SKILLS
