--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: BabkaDialog4
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speaker: "\u0418\u043D\u0443"
    text: "\u0421\u0442\u043E\u0439, \u043A\u0430\u0440\u0433\u0430 \u0441\u0442\u0430\u0440\u0430\u044F!
      \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u044B \u043E\u0442\u0432\u0435\u0442\u044B"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: ...
  - speaker: "\u0418\u043D\u0443"
    text: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043C\u0435\u0441\u0442\u043E?
      \u0418 \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0432\u043E\u043E\u0431\u0449\u0435
      \u0432\u044B\u043B\u0435\u0437\u043B\u0430?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041E\u0442\u0432\u0435\u0442\u044B \u0435\u0439 \u043F\u043E\u0434\u0430\u0432\u0430\u0439...
      \u0420\u0430\u043D\u044C\u0448\u0435 \u0432\u043E\u043D \u043B\u044E\u0434\u0438
      \u0431\u0435\u0437 \u043E\u0442\u0432\u0435\u0442\u043E\u0432 \u0436\u0438\u043B\u0438
      \u2014 \u0438 \u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0443
      \u0441\u0430\u0436\u0430\u043B\u0438"
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u041D\u0435 \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0430."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u0413\u0434\u0435 \u043C\u044B?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0412 \u043C\u0435\u0441\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C\u2026
      \u0438 \u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0438
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u0435\u0442\u044C \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442
      \u043C\u043E\u043B\u0447\u0430\u0442\u044C."
  - speaker: "\u0418\u043D\u0443"
    text: "\u042F \u0422\u0410\u041A \u0418 \u0413\u041E\u0412\u041E\u0420\u0418\u041B\u0410!"
  - speaker: "\u0418\u043D\u0443"
    text: "\u042F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 - \u044D\u0442\u043E \u043D\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F!
      \u041C\u044B \u0432\u0438\u0434\u0438\u043C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0443 \u044D\u0442\u043E\u0439 \u0448\u0442\u0443\u043A\u0438,
      \u0430 \u0432\u043D\u0443\u0442\u0440\u0438 \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u0435\u0449\u0451!"
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: ...
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u041C\u043D\u0435 \u0443\u0436\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u044D\u0442\u043E\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
  - speaker: "\u0418\u043D\u0443"
    text: "\u0410 \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!"
  - speaker: "\u0418\u043D\u0443"
    text: "\u0422\u043E \u0435\u0441\u0442\u044C \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F...
      \u041D\u043E \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0447\u0442\u043E
      \u044F \u043F\u0440\u0430\u0432\u0430!"
  - speaker: "\u0418\u043D\u0443"
    text: "\u0410 \u043A\u0430\u043A \u0442\u044B \u0437\u0434\u0435\u0441\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041F\u043E\u043C\u0435\u0440\u043B\u0430, \u0434\u0443\u0440\u0430."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442..."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0410 \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u043E."
  - speaker: "\u0418\u043D\u0443"
    text: "\u0427\u0435\u0433\u043E \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u043E?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0414\u0430 \u043A\u0442\u043E \u0436 \u0435\u0433\u043E \u0437\u043D\u0430\u0435\u0442."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u043E\u0443\u0442\u0435\u0440
      \u043C\u0438\u0433\u0430\u043B, \u043F\u043E\u0442\u043E\u043C \u043A\u043E\u0442
      \u043E\u0431\u043B\u044B\u0441\u0435\u043B, \u043F\u043E\u0442\u043E\u043C
      \u043C\u0435\u043D\u044F \u0437\u0430\u0441\u043E\u0441\u0430\u043B\u043E \u0441\u044E\u0434\u0430
      \u043A \u0447\u0435\u0440\u0442\u043E\u0432\u043E\u0439 \u043C\u0430\u0442\u0435\u0440\u0438."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u042D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A
      \u0431\u0440\u0435\u0434 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0435\u0433\u043E."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0436 \u0440\u043E\u0432\u043D\u043E
      \u0442\u044B \u0441\u0442\u043E\u0438\u0448\u044C \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
      \u043A\u043E\u0433\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0433\u043D\u0443\u043B\u0438
      \u0434\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: ...
  - speaker: "\u0418\u043D\u0443"
    text: "\u0412\u044B \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B\u0438?.."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0410, \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041D\u0443 \u0432\u0441\u0451, \u0437\u0430\u0431\u043E\u043B\u0442\u0430\u043B\u0430\u0441\u044C
      \u044F \u0441 \u0432\u0430\u043C\u0438."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u0427\u0442\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041C\u0435\u0441\u0442\u043D\u044B\u0435."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041D\u0435 \u043B\u044E\u0431\u044F\u0442 \u043E\u043D\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0442\u0443\u0442 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0435 \u0448\u0430\u0441\u0442\u0430\u044E\u0442."
  - speaker: "\u0418\u043D\u0443"
    text: "\u0427\u0422\u041E \u0417\u041D\u0410\u0427\u0418\u0422 \"\u041C\u0415\u0421\u0422\u041D\u042B\u0415\"?!"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043C\u0438 \u0443\u0432\u0438\u0434\u0438\u0442\u0435."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0418 \u0434\u0430 - \u0435\u0441\u043B\u0438 \u044D\u0442\u0430 \u043B\u043E\u0445\u043C\u0430\u0442\u0430\u044F
      \u0441\u0434\u043E\u0445\u043D\u0435\u0442, \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0441\u044F
      \u043E\u0441\u043E\u0431\u043E. \u041E\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043B\u043E\u0434\u044F\u0442\u0441\u044F."
  - speaker: "\u0418\u043D\u0443"
    text: "\u042D\u0419!"
  - speaker: 
    text: "*\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0442\u044C\u0441\u044F \u0432
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435*"
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u0421\u0422\u041E\u0419\u0422\u0415."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0427\u0435\u0433\u043E \u0435\u0449\u0451?"
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u041A\u0430\u043A \u043E\u0442\u0441\u044E\u0434\u0430 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0425\u0435-\u0445\u0435..."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u0437\u043D\u0430\u043B\u0430
      - \u043C\u0435\u043D\u044F \u0431\u044B \u0442\u0443\u0442 \u0443\u0436\u0435
      \u043D\u0435 \u0431\u044B\u043B\u043E."
  - speaker: 
    text: "*\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F...*"
  - speaker: "\u0418\u043D\u0443"
    text: "...\u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0443\u043C\u043D\u0435\u0435."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u041D\u0435\u0442."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u044F."
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u041B\u041A\u041C,
      \u0427\u0422\u041E\u0411\u042B \u0411\u0418\u0422\u042C \u0412\u0420\u0410\u0413\u041E\u0412"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u0418\u041D\u0423 \u0418 \u041B\u0418\u041B\u0418\u0422 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u042E\u0422
      \u0420\u0410\u0417\u041D\u042B\u0415 \u0422\u0418\u041F\u042B \u041E\u0420\u0423\u0416\u0418\u042F"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u0418\u041D\u0423 \u041F\u041E\u0414\u0425\u041E\u0414\u0418\u0422 \u0414\u041B\u042F
      \u0411\u041B\u0418\u0416\u041D\u0418\u0425 \u0414\u0418\u0421\u0422\u0410\u041D\u0426\u0418\u0419,
      \u0410 \u041B\u0418\u041B\u0418\u0422 \u0414\u041B\u042F \u0414\u0410\u041B\u042C\u041D\u0418\u0425"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u041F\u041E\u041C\u0418\u041C\u041E \u041E\u0411\u042B\u0427\u041D\u041E\u0419
      \u0410\u0422\u0410\u041A\u0418 \u0423 \u041D\u0418\u0425 \u0415\u0421\u0422\u042C
      \u041D\u0410\u0412\u042B\u041A\u0418"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u0414\u041B\u042F \u0418\u0425 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u041D\u0418\u042F
      \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"E\""
