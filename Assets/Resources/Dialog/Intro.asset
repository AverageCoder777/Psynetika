MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: Intro
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speakerRu: 
    speakerEn: 
    textRu: "*\u041B\u0438\u043B\u0438\u0442 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F, \u0418\u043D\u0443 \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C*"
    textEn: '*Lilit wakes up, Inu is already standing nearby*'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0427\u0442\u043E \u0437\u0430..."
    textEn: What the...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u041E, \u0440\u0430\u0437\u0434\u0443\u043F\u0438\u043B\u0430\u0441\u044C!"
    textEn: Oh, she's awake!
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u043A\u0442\u043E?"
    textEn: Who are you?
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E? \u042F \u0441\u043C\u043E\u0442\u0440\u044E, \u0442\u044B \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u0442\u0430\u043A \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430\u0441\u044C..."
    textEn: Seriously? I see your head's screwed on straight enough...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u042F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u043D\u0435 \u0448\u0442\u0443\u043A\u0438!\n\u042F \u0431\u044B\u043B\u0430 \u043F\u0440\u0430\u0432\u0430! \u042F \u0431\u044B\u043B\u0430 \u043F\u0440\u0430\u0432\u0430!"
    textEn: 'I said this isn''t just jokes!

      I was right! I was right!'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0422\u044B \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F? \u0422\u044B \u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u0438\u0437 \u0441\u0435\u0431\u044F \u0433\u0435\u043D\u0438\u044F, \u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u043F\u0440\u044F\u0447\u044C \u043F\u0430\u0440\u0443 \u043C\u0438\u043A\u0440\u043E-\u0438\u0437\u0432\u0438\u043B\u0438\u043D, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0442\u043E \u044F..."
    textEn: "Are you taking the mickey? You were acting like a genius, and now you can\u2019t even bother to use a couple of micro-gyruses to work out who I am..."
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0431\u044B\u043B\u0430 \u0442\u0430\u043A \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0447\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442? "
    textEn: 'Why were you so sure nothing would happen? '
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0442\u044B \u0441\u043B\u0443\u0448\u0430\u043B\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0431\u044F \u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0442\u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0430 \u0431\u044B \u043C\u043E\u0435 \u043C\u043D\u0435\u043D\u0438\u0435, \u0442\u043E \u043C\u044B \u0431\u044B \u0431\u044B\u043B\u0438 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u0434\u043E\u043C\u0430, \u0432 \u0443\u044E\u0442\u043D\u043E\u0439 \u043F\u043E\u0441\u0442\u0435\u043B\u0438, \u0430 \u043D\u0435 \u0432 \u044D\u0442\u043E\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u043D\u0435\u0442 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0440\u043E\u043C\u0435 \u044D\u0442\u0438\u0445 \u0434\u0443\u0440\u0430\u0446\u043A\u0438\u0445 \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432"
    textEn: "If you\u2019d listened to more than just yourself and taken my opinion on board, even just a little, we\u2019d be safe at home in our cosy bed, rather than in this strange place where there\u2019s absolutely nothing but these silly wires"
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u0432\u044B\u043C\u043E\u0442\u0430\u043B\u0430... \u0425\u043E\u0440\u043E\u0448 \u0443\u0436 \u0441\u043E\u043F\u043B\u0438 \u0440\u0430\u0437\u0432\u043E\u0437\u0438\u0442\u044C.\n\u0422\u0432\u043E\u0435 \u043D\u044B\u0442\u044C\u0435 \u044F \u0443\u0437\u0430\u044E \u0438\u0437 \u0442\u044B\u0441\u044F\u0447\u0438, \u0418\u043D\u0443... \u041B\u0443\u0447\u0448\u0435 \u043F\u043E\u0432\u0435\u0434\u0430\u0439, \u0447\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C, \u043F\u043E\u043A\u0430 \u044F \u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: "You\u2019ve really worn me out... Stop whingeing already.\nI\u2019d recognise your whingeing anywhere, Ina... You\u2019d better tell me what you\u2019ve been up to whilst I was out cold."
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436\u0435 \u0442\u0440\u0438\u0436\u0434\u044B \u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u043F\u043E \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0443! \u0422\u0443\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u0430, \u0442\u0430\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u0430, \u0438 \u0432\u0441\u0451! \u041D\u0438\u0447\u0435\u0433\u043E \u0442\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442!"
    textEn: "I\u2019ve already walked round the room three times! There are wires here, wires there, and that\u2019s it! There\u2019s nothing else in here!"
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u042F \u043D\u0435 \u0432\u0438\u0436\u0443 \u043A\u043E\u043D\u0446\u0430 \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B... \u0422\u044B \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0430 \u043F\u0440\u043E\u0439\u0442\u0438 \u0432\u0434\u0430\u043B\u044C?"
    textEn: "I can\u2019t see the end of this room\u2026 Have you tried walking further in?"
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430..."
    textEn: Yeah...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0442\u044B \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434, \u0442\u043E \u044F \u0431\u044B \u0442\u0435\u0431\u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u0440\u044F\u0434\u043E\u043C \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430..."
    textEn: "If you\u2019d really been trying to find a way out, I wouldn\u2019t be seeing you here right now..."
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u0442\u043E\u044F\u043B\u0430 \u0438 \u0436\u0434\u0430\u043B\u0430, \u043F\u043E\u043A\u0430 \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u0441\u044C? \u041A\u0430\u043A \u043C\u0438\u043B\u043E."
    textEn: Did you really stand there waiting for me to wake up? How sweet.
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u041E\u0442\u0441\u0442\u0430\u043D\u044C.."
    textEn: Back off...
