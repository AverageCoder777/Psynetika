  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: Intro
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speakerRu: 
    speakerEn: 
    textRu: "*\u041B\u0438\u043B\u0438\u0442 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F, \u0418\u043D\u0443 \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C*"
    textEn: '*Lilit wakes up, Inu is already standing nearby*'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0427\u0442\u043E \u0437\u0430..."
    textEn: What the...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u041E, \u0440\u0430\u0437\u0434\u0443\u043F\u0438\u043B\u0430\u0441\u044C!"
    textEn: Oh, she's awake!
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u043A\u0442\u043E?"
    textEn: Who are you?
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E? \u042F \u0441\u043C\u043E\u0442\u0440\u044E, \u0442\u044B \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u0442\u0430\u043A \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430\u0441\u044C..."
    textEn: Seriously? I see your head's screwed on straight enough...
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u042F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u043D\u0435 \u0448\u0442\u0443\u043A\u0438!\n\u042F \u0431\u044B\u043B\u0430 \u043F\u0440\u0430\u0432\u0430! \u042F \u0431\u044B\u043B\u0430 \u043F\u0440\u0430\u0432\u0430!"
    textEn: 'I said this isn''t just jokes!

      I was right! I was right!'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F?\n\u0422\u044B \u0441\u0442\u0440\u043E\u0438\u0448\u044C \u0438\u0437 \u0441\u0435\u0431\u044F\n\u043A\u0430\u043A\u043E\u0433\u043E-\u0442\u043E \u043F\u0441\u0438\u0445\u0438\u043D\u0430,\n\u043A\u0430\u043A\u0430\u0435\u0448\u044C\u0441\u044F \u043F\u043E \u0441\u0442\u0435\u043D\u043E\u0439\n\u043F\u0440\u0435\u0434\u0430\u0433\u0430\u044F\u0441\u044C \u043C\u0438\u043A\u0440\u043E-\n\u0438\u0437\u0432\u0438\u043B\u0438\u043D\u044B, \u0447\u0442\u043E\u0431\u044B\n\u043F\u043E\u043D\u044F\u0442\u044C \u043A\u0442\u043E \u044F..."
    textEn: 'You''re kidding?

      You act like some

      psycho, crawling

      along the wall

      through micro-

      crevices to figure

      out who I am...'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0422\u044B \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F\n\u043D\u0430\u0437\u0430\u0434? \u0421\u0442\u0440\u043E\u0438\u0448\u044C\n\u0438\u0437 \u0441\u0435\u0431\u044F \u043A\u0430\u043A\u0443\u044E-\u0442\u043E\n\u043F\u0441\u0438\u043D\u0443, \u043A\u0430\u043A\u0430\u0435\u0448\u044C\u0441\u044F \u043F\u043E\n\u0441\u0442\u0435\u043D\u043A\u0435 \u043F\u0440\u0435\u0434\u0430\u0433\u0430\u044F\u0441\u044C\n\u043C\u0438\u043A\u0440\u043E-\u0438\u0437\u0432\u0438\u043B\u0438\u043D\u044B,\n\u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C \u043A\u0442\u043E\n\u044F... "
    textEn: 'You''re kidding

      back? Act like a

      psycho, crawl

      along the wall

      through micro-

      crevices to figure

      out who I am... '
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0431\u044B\u043B\u0430\n\u0442\u0430\u043A\u0430\u044F \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0447\u0442\u043E\n\u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\n\u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442? "
    textEn: 'Why were you

      so sure nothing

      would happen? '
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0442\u044B \u0441\u043B\u0443\u0448\u0430\u043B\u0430\n\u043D\u0435 \u0441\u0435\u0431\u044F \u0438 \u0445\u043E\u0442\u044F \u0431\u044B\n\u043F\u0440\u0438\u043D\u044F\u043B\u0430 \u043C\u043E\u0451\n\u043C\u043D\u0435\u043D\u0438\u0435, \u0442\u043E \u043C\u044B \u0431\u044B\n\u0431\u044B\u043B\u0438 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438,\n\u0434\u043E\u043C\u0430, \u0432 \u0443\u044E\u0442\u043D\u043E\u0439\n\u043F\u043E\u0441\u0442\u0435\u043B\u0438, \u0430 \u043D\u0435 \u0432\n\u044D\u0442\u043E\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u043C\n\u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u043D\u0435\u0442\n\u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\n\u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0440\u043E\u043C\u0435\n\u044D\u0442\u0438\u0445 \u0434\u0443\u0440\u0430\u0446\u043A\u0438\u0445\n\u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432"
    textEn: 'If you''d listened

      not just to

      yourself and

      accepted my

      opinion, we''d be

      safe, home, in a

      cozy bed, not in

      this strange place

      where there''s

      absolutely

      nothing but these

      damn wires'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F\n\u043E\u0431\u0440\u0430\u0442\u043D\u043E? \u0421\u0442\u0440\u043E\u0438\u0448\u044C\n\u0438\u0437 \u0441\u0435\u0431\u044F \u043A\u0430\u043A\u0443\u044E-\u0442\u043E\n\u043F\u0441\u0438\u043D\u0443, \u043A\u0430\u043A\u0430\u0435\u0448\u044C\u0441\u044F \u043F\u043E\n\u0441\u0442\u0435\u043D\u043A\u0435 \u043F\u0440\u0435\u0434\u0430\u0433\u0430\u044F\u0441\u044C\n\u043C\u0438\u043A\u0440\u043E-\u0438\u0437\u0432\u0438\u043B\u0438\u043D\u044B,\n\u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C \u043A\u0442\u043E\n\u044F... "
    textEn: 'You''re kidding

      back? Act like a

      psycho, crawl

      along the wall

      through micro-

      crevices to figure

      out who I am... '
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436\u0435 \u0442\u0440\u0438\u0436\u0434\u044B\n\u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443! \n\u0422\u0443\u0442 \u043F\u0440\u043E\u0441\u043B\u043E\u0439\u043A\u0443\n\u0440\u0430\u0437\u0443\u0437\u043D\u0430\u0439 \u0438\u0437 \u0442\u043E\u043B\u043F\u044B,\n\u0418\u043D\u0443... \n\u0425\u043E\u0440\u043E\u0448 \u0443\u0436\u0435\n\u0441\u043E\u043F\u043B\u0438 \u0440\u0430\u0437\u0432\u043E\u0437\u044F\u0442"
    textEn: 'I''ve already

      circled the room

      three times!

      Figure out the

      substrate from the

      crowd, Inu...

      Enough with the

      sniveling'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0432\u0430 \u0442\u0432\u043E\u0438\u0445 \u043D\u044B\u0442\u044C\u044F\n\u044F \u0443\u0436\u0435 \u0443\u0436\u0438\u043C\u0430\u043B\u0430\n\u043E\u0431\u043E\u0438\u043C \u0441\u0440\u0435\u0437\u0430\u043C! \u0422\u0430\u043C\n\u043F\u0443\u0442\u044C \u043F\u0440\u043E\u0432\u0430\u0434\u043E\u0432\u0430\u043B\u0430,\n\u0442\u0430\u043C \u043F\u0440\u043E\u0432\u0430\u0434\u043E\u0432\u0430\u043B\u0430,\n\u0438 \u0432\u0441\u0451! \u041D\u0438\u0447\u0435\u0433\u043E \u0442\u0443\u0442\n\u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442!"
    textEn: 'I''ve already

      crushed your two

      whines with both

      edges! Led the way

      there, led the way

      there, and that''s

      it! Nothing more

      here!'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: ...
    textEn: ...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u043C\u0435\u043D\u044F \u0443\u0436\u0435\n\u0432\u044B\u043C\u043E\u0442\u0430\u043B\u0430...\n\u0425\u043E\u0440\u043E\u0448 \u0443\u0436\n\u0441\u043E\u043F\u043B\u0438 \u0440\u0430\u0437\u0432\u043E\u0437\u044F\u0442"
    textEn: 'You''ve worn me

      out...

      Enough with the

      sniveling'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u0432\u043E\u0435 \u043D\u044B\u0442\u044C\u0435 \u044F \u0443\u0436\u0435\n\u0443\u0436\u0438\u043C\u0430\u044E \u043E\u0431\u043E\u0438\u043C \u0441\u0440\u0435\u0437\u0430\u043C,\n\u043F\u043E\u043A\u0430 \u0442\u044B \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''m crushing your

      whining with both

      edges while you''re

      out cold'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436\u0435 \u0442\u0440\u0438\u0436\u0434\u044B\n\u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443... \n\u041B\u0443\u0447\u0448\u0435 \u043A\u0430lope\u0434\u0443\u0439\n\u043C\u043D\u0435 \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\n\u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''ve already

      circled the room

      three times...

      Better guide me

      than have been

      out cold'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041B\u0443\u0447\u0448\u0435 \u043A\u0430lope\u0434\u0443\u0439\n\u043C\u043D\u0435 \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\n\u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'Better guide me

      than have been

      out cold'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436 \u0442\u0440\u0438\u0436\u0434\u044B\n\u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443... \n\u041B\u0443\u0447\u0448\u0435 \u043A\u0430lope\u0434\u0443\u0439\n\u043C\u043D\u0435 \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\n\u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''ve already

      circled the room

      three times...

      Better guide me

      than have been

      out cold'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436\u0435 \u0442\u0440\u0438\u0436\u0434\u044B\n\u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443... \n\u041B\u0443\u0447\u0448\u0435 \u043A\u0430lope\u0434\u0443\u0439\n\u043C\u043D\u0435 \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\n\u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''ve already

      circled the room

      three times...

      Better guide me

      than have been

      out cold'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0430 \u044F \u0443\u0436 \u0442\u0440\u0438\u0436\u0434\u044B\n\u043E\u0431\u043E\u0448\u043B\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0443... \n\u041B\u0443\u0447\u0448\u0435 \u043A\u0430lope\u0434\u0443\u0439\n\u043C\u043D\u0435 \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\n\u0431\u044B\u043B\u0430 \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''ve already

      circled the room

      three times...

      Better guide me

      than have been

      out cold'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041E\u0422\u0421\u0422\u0410\u041D\u042C..."
    textEn: BACK OFF...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\n\u0441\u0442\u043E\u044F\u043B\u0430 \u0438 \u0436\u0434\u0430\u043B\u0430,\n\u043F\u043E\u043A\u0430 \u044F \u043F\u0440\u043E\u0431\u0443\u044E\n\u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434? \n\u041A\u0430\u043A \u043C\u0438\u043B\u043E."
    textEn: 'You really stood

      and waited

      while I tried to

      find a way out?

      How sweet.'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0422\u0432\u043E\u0438 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442\n\u044F \u0443\u0436\u0435 \u0443\u0436\u0438\u043C\u0430\u043B\u0430\n\u043E\u0431\u043E\u0438\u043C \u0441\u0440\u0435\u0437\u0430\u043C, \n\u043F\u043E\u043A\u0430 \u0442\u044B \u0432 \u043E\u0442\u043A\u043B\u044E\u0447\u043A\u0435"
    textEn: 'I''ve already

      crushed your five

      minutes with both

      edges while you

      were out cold'
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0414\u0430..."
    textEn: Yeah...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u0440\u0438\u0436\u0434\u044B \u043E\u0431\u043E\u0448\u043B\u0430\n\u043A\u043E\u043C\u043D\u0430\u0442\u0443... \n\u0422\u044B \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0430\n\u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434?"
    textEn: 'Circled the room

      three times...

      Did you try to

      find the exit?'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0414\u0410..."
    textEn: YEAH...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u041E\u0442\u0441\u0442\u0430\u043D\u044C..."
    textEn: Back off...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\n\u0441\u0442\u043E\u044F\u043B\u0430 \u0438 \u0436\u0434\u0430\u043B\u0430,\n\u043F\u043E\u043A\u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u0430\n\u043F\u0440\u043E\u0431\u0443\u044E \u043D\u0430\u0439\u0442\u0438\n\u0432\u044B\u0445\u043E\u0434? \n\u041A\u0430\u043A \u043C\u0438\u043B\u043E."
    textEn: 'Really stood and

      waited while I

      simply try to find

      the exit?

      How sweet.'
  - speakerRu: "\u0418\u043D\u0443"
    speakerEn: Inu
    textRu: "\u0412\u042B \u0411\u042B \u0421\u0415\u0419\u0427\u0410\u0421\n\u0420\u042F\u0414\u041E\u041C \u041D\u0415\n\u0412\u0418\u0414\u0415\u041B\u0410..."
