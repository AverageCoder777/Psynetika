MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: BabkaDialog3
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0418 \u043A\u0443\u0434\u0430 \u0434\u0430\u043B\u044C\u0448\u0435?"
    textEn: And where to next?
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u0412\u044B \u0447\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u0443\u043C\u0430\u043B\u0438\u0448\u0451\u043D\u043D\u044B\u0435? \u041D\u0430\u0432\u0435\u0440\u0445 \u043F\u043E\u043B\u0437\u0438\u0442\u0435!"
    textEn: Are you completely addled? Climb up!
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u042F \u0442\u0443\u0434\u0430 \u043D\u0435 \u0437\u0430\u043B\u0435\u0437\u0443..."
    textEn: I'm not climbing up there...
  - speakerRu: "\u041B\u0438\u043B\u0438\u0442"
    speakerEn: Lilit
    textRu: "\u0422\u044B \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C \u043C\u043D\u0435, \u043A\u0430\u043A \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u043F\u0441\u0438\u043D\u0435, \u043A\u0430\u0440\u0430\u0431\u0430\u043A\u0430\u0442\u044C\u0441\u044F \u043F\u043E \u0441\u0442\u0435\u043D\u0430\u043C? \u042D\u0442\u043E \u043D\u0438\u0436\u0435 \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430."
    textEn: You seriously expect me, like a dog, to clumb up walls? That's beneath my dignity.
  - speakerRu: "\u041F\u0440\u043E\u0432\u0438\u0434\u043D\u0438\u0446\u0430"
    speakerEn: The Seer
    textRu: "\u041D\u0443 \u0432\u043E\u0442 \u043F\u0441\u0438\u043D\u0430 \u043F\u0443\u0441\u0442\u044C \u0438 \u043B\u0435\u0437\u0435\u0442!"
    textEn: Well, let's go, dog!
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0427\u0422\u041E\u0411\u042B \u0421\u041C\u0415\u041D\u0418\u0422\u042C \u041F\u0415\u0420\u0421\u041E\u041D\u0410\u0416\u0410 \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \u041F\u041A\u041C"
    textEn: TO SWITCH CHARACTER PRESS RMB
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u041D\u0423 \u0423\u041C\u0415\u0415\u0422 \u0417\u0410\u0411\u0418\u0420\u0410\u0422\u042C\u0421\u042F \u041D\u0410 \u041D\u0415\u041A\u041E\u0422\u041E\u0420\u042B\u0415 \u0421\u0422\u0415\u041D\u042B"
    textEn: INU CAN CLIMB ON SOME WALLS
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0427\u0422\u041E\u0411\u042B \u042D\u0422\u041E \u0421\u0414\u0415\u041B\u0410\u0422\u042C, \u0417\u0410\u041F\u0420\u042B\u0413\u041D\u0418\u0422\u0415 \u041D\u0410 \u0421\u0422\u0415\u041D\u0423. \u0412\u042B \u041C\u041E\u0416\u0415\u0422\u0415 \u041E\u0422\u041F\u0420\u042B\u0413\u041D\u0423\u0422\u042C \u041E\u0422 \u041D\u0415\u0415 \u0421 \u041F\u041E\u041C\u041E\u0429\u042C\u042E SPACE"
    textEn: TO DO THIS, JUMP ONTO THE WALL. YOU CAN JUMP FROM WALL WITH SPACE WHILE ON IT
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u041B\u041A\u041C, \u0427\u0422\u041E\u0411\u042B \u0411\u0418\u0422\u042C \u0412\u0420\u0410\u0413\u041E\u0412"
    textEn: USE LMB TO ATTACK ENEMIES
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u041D\u0423 \u0418 \u041B\u0418\u041B\u0418\u0422 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u042E\u0422 \u0420\u0410\u0417\u041D\u042B\u0415 \u0422\u0418\u041F\u042B \u041E\u0420\u0423\u0416\u0418\u042F"
    textEn: INU AND LILIT USE DIFFERENT WEAPON TYPES
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0418\u041D\u0423 \u041F\u041E\u0414\u0425\u041E\u0414\u0418\u0422 \u0414\u041B\u042F \u0411\u041B\u0418\u0416\u041D\u0418\u0425 \u0414\u0418\u0421\u0422\u0410\u041D\u0426\u0418\u0419, \u0410 \u041B\u0418\u041B\u0418\u0422 \u0414\u041B\u042F \u0414\u0410\u041B\u042C\u041D\u0418\u0425"
    textEn: INU IS FOR CLOSE RANGE, LILIT FOR LONG RANGE
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u041F\u041E\u041C\u0418\u041C\u041E \u041E\u0411\u042B\u0427\u041D\u041E\u0419 \u0410\u0422\u0410\u041A\u0418 \u0423 \u041D\u0418\u0425 \u0415\u0421\u0422\u042C \u041D\u0410\u0412\u042B\u041A\u0418"
    textEn: BESIDES BASIC ATTACK THEY HAVE SKILLS
  - speakerRu: "\u0418\u043D\u0444\u043E"
    speakerEn: Info
    textRu: "\u0414\u041B\u042F \u0418\u0425 \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u041D\u0418\u042F \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"E\""
    textEn: TO USE THEM PRESS "E"
