  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: BabkaDialog2
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0421\u0430\u043B\u0430\u043C \u0430\u043B\u0435\u0439\u043A\u0443\u043C
      \u0440\u0443\u0431\u043B\u044C \u0431\u0443\u0434\u0435\u0442? \u0423\u0431\u044C\u044E,
      \u0437\u0430\u0440\u0435\u0436\u0443! "
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: "\u0416\u0435\u043D\u0449\u0438\u043D\u0430! \u0412\u044B \u0432 \u0441\u0432\u043E\u0435\u043C
      \u0443\u043C\u0435?"
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0412\u0430\u043C \u0447\u0442\u043E \u0431\u0430\u0431\u043A\u0438 \u043D\u0435
      \u043D\u0443\u0436\u043D\u044B? \u0422\u0430\u043C \u0441\u0443\u043D\u0434\u0443\u043A!
      \u0410 \u043D\u0443-\u043A\u0430 \u0434\u0430\u0432\u0430\u043B\u0438 \u043F\u043E\u0448\u0443\u0440\u0448\u0430\u043B\u0438!"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u041D\u0410 \u041D\u0415\u041A\u041E\u0422\u041E\u0420\u042B\u0415 \u041F\u041B\u0410\u0422\u0424\u041E\u0420\u041C\u042B
      \u041C\u041E\u0416\u041D\u041E \u0417\u0410\u041F\u0420\u042B\u0413\u041D\u0423\u0422\u042C
      \u0421\u041D\u0418\u0417\u0423, \u0410 \u0422\u0410\u041A\u0416\u0415 \u0421\u041F\u0420\u042B\u0413\u041D\u0423\u0422\u042C,
      \u041D\u0410\u0416\u0410\u0412 S+SPACE"
  - speaker: "\u0418\u043D\u0444\u043E"
    text: "\u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u0418\u0425,
      \u0427\u0422\u041E\u0411\u042B \u0417\u0410\u0411\u0420\u0410\u0422\u042C \u041D\u0410\u0413\u0420\u0410\u0414\u0423"
