  m_Script: {fileID: 11500000, guid: ac6eaef98d65f704996c054f4ca51d8b, type: 3}
  m_Name: BabkaDialog1
  m_EditorClassIdentifier: Assembly-CSharp::LinearDialogue
  lines:
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u041A\u0442\u043E \u0442\u0443\u0442 \u0448\u0443\u043C\u0438\u0442?!
      \u0412\u0435\u0447\u043D\u043E \u043C\u043D\u0435 \u043F\u043E\u043A\u043E\u044F
      \u043D\u0435 \u0434\u0430\u044E\u0442..."
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: ...
  - speaker: "\u0418\u043D\u0443"
    text: ...
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0427\u0442\u043E \u0437\u0430 \u0447\u0443\u0434\u0438\u0449\u0435 \u043B\u043E\u0445\u043C\u0430\u0442\u043E\u0435?!
      \u0411\u0440\u044B\u0441\u044C \u043E\u0442\u0441\u044E\u0434\u0430!"
  - speaker: "\u0418\u043D\u0443"
    text: "\u0414\u0430 \u043C\u044B \u0432 \u0446\u0435\u043B\u043E\u043C \u0442\u043E
      \u0438 \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432, \u043F\u043E\u043D\u044F\u0442\u044C
      \u0431\u044B \u043A\u0430\u043A..."
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0412\u043E\u0442 \u0436\u0435 \u043D\u0435\u043C\u043E\u0449\u043D\u043E\u0435
      \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0435... \u0420\u0443\u043A\u0438,
      \u043D\u043E\u0433\u0438 \u0435\u0441\u0442\u044C, \u0432\u043E\u0442 \u0438
      \u0438\u0434\u0438\u0442\u0435 \u043E\u0442\u0441\u044E\u0434\u0430!"
  - speaker: "\u041B\u0438\u043B\u0438\u0442"
    text: ...
  - speaker: "\u0418\u043D\u0443"
    text: ...
  - speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430"
    text: "\u0412\u0441\u0435\u043C\u0443 \u0443\u0447\u0438\u0442\u044C \u0432\u0430\u0441...
      \u041B\u0435\u0441\u0442\u043D\u0438\u0446\u0443 \u0432\u0438\u0434\u0438\u0448\u044C?
      \u0417\u0430\u043B\u0435\u0437\u044C"
  - speaker: 
    text: "\u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"F\", \u0427\u0422\u041E\u0411\u042B
      \u0412\u0417\u0410\u0418\u041C\u041E\u0414\u0415\u0419\u0421\u0422\u0412\u041E\u0412\u0410\u0422\u042C
      \u0421 \u041E\u041A\u0420\u0423\u0416\u0415\u041D\u0418\u0415\u041C"
